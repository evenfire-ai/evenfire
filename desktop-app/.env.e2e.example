# Copy to .env.e2e and adjust values.
# AppService reads these from config.ts at module load time
EXTERNAL_REST_API_BASE_URL=http://localhost:8091
RPC_PROXY_BASE_URL=http://localhost:8094
E2E_ALLOW_DEV_PORT_FORWARD=0
MEMBER_REGISTRATION_SERVICE_BASE_URL=http://localhost:8092

# Test-specific (read by test helpers)
E2E_DEV_LOGIN_EMAIL=dev@clerum.local
# Second user for cross-device Playwright tests (cross-device-sessions.test.ts T2)
E2E_DEV_LOGIN_EMAIL_2=test2@clerum.io
E2E_DEV_LOGIN_NAME=Dev User
# hostRef of the agent to test against (must be accessible by the login user)
E2E_HOST_REF=agent2
