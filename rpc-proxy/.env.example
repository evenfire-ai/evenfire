# Local development only: start control-api with CLERUM_DEV_MODE=true first.
# Export these values before starting; npm run dev does not load this file.
# NODE_ENV=production rejects CLERUM_DEV_MODE=true and requires an explicit public key.
CLERUM_DEV_MODE=true
# Unset or blank uses control-api/.dev-keys in this checkout. A nonblank override
# must be absolute and identical in control-api, rpc-proxy, and external-rest-api.
EVENFIRE_DEV_KEY_STORE=
RPC_PROXY_PORT=8094
RPC_PROXY_CORS_ORIGIN=http://localhost:3000
# Blank uses rpc.public.pem from the store in explicit dev mode. If control-api
# uses CONTROL_API_RPC_JWT_PRIVATE_KEY, set its matching public key here instead.
# Restart/reconfigure after changing keys; running verifiers do not refresh them.
# Explicit verifier keys require one RSA >=2048 PEM object (SPKI/PKCS#1 public
# or X509 carrier); private PEM env input is legacy-compatible, not recommended.
# Public store files never accept private material. Material/read limit: 64 KiB.
# The store requires POSIX guarantees, trusted ancestors and the same effective
# UID across services; otherwise supply the matching keys explicitly.
RPC_PROXY_JWT_PUBLIC_KEY=
RPC_PROXY_JWT_ISSUER=control-api
RPC_PROXY_JWT_AUDIENCE=rpc-proxy
RPC_PROXY_CONTROL_API_BASE_URL=http://control-api.control-plane.svc.cluster.local:8090/api/v1
RPC_PROXY_CONTROL_API_SERVICE_TOKEN=replace-with-rpc-proxy-token
RPC_PROXY_CONTROL_API_SERVICE_NAME=rpc-proxy
RPC_PROXY_CONTROL_API_CACHE_TTL_MS=30000
RPC_PROXY_UPSTREAM_TIMEOUT_MS=60000
RPC_PROXY_MAX_TOKEN_LENGTH=4096
RPC_PROXY_ALLOWED_METHOD_PATTERN=^[a-zA-Z0-9_.:-]{1,120}$
RPC_PROXY_STREAM_MAX_LIFETIME_MS=600000
RPC_PROXY_STREAM_INTERVAL_MS=3000
RPC_PROXY_STREAM_KEEPALIVE_MS=15000
RPC_PROXY_STREAM_MAX_CONCURRENT=1000
RPC_PROXY_STREAM_MAX_PER_USER=3
RPC_PROXY_STREAM_MAX_PER_USER_HOST=1
RPC_PROXY_STREAM_IDLE_TIMEOUT_MS=60000
RPC_PROXY_ACTIVITY_STREAM_MAX_LIFETIME_MS=600000
RPC_PROXY_ACTIVITY_STREAM_KEEPALIVE_MS=15000
RPC_PROXY_ACTIVITY_STREAM_IDLE_TIMEOUT_MS=60000
RPC_PROXY_ACTIVITY_STREAM_MAX_CONCURRENT=1000
RPC_PROXY_ACTIVITY_STREAM_MAX_PER_USER=3
RPC_PROXY_ACTIVITY_STREAM_MAX_PER_USER_HOST=1
