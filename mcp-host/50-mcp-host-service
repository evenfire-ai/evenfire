#!/bin/bash
# s6 runs this once. The single UID1001 child has no automatic relaunch path.
set -euo pipefail
if [[ "$(id -u)" != 1001 || "$(id -g)" != 1001 ]]; then
  printf '%s\n' '{"event":"mcp-host-start-blocked","reason":"RuntimeUidMismatch"}' >&2
  exit 1
fi
if [[ ! -d /config/workspace || -L /config/workspace ]]; then
  printf '%s\n' '{"event":"mcp-host-start-blocked","reason":"LayoutUnsafe"}' >&2
  exit 1
fi
# Never chown /app or retained source files. Code stays root-owned; volume
# permissions come from the fsGroup/init contract, not a startup fallback.
export DISPLAY=:1
node /app/mcp-host/ops/desktop-supervisor.mjs </dev/null &
printf '%s\n' '{"event":"mcp-host-supervisor-launched"}'
