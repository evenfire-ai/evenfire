{
  "name": "clerum-mcp-host",
  "version": "0.1.284",
  "description": "MCP Host - reads Host CRD and provides LLM access via OpenAI/Claude",
  "main": "dist/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "lint": "eslint 'src/**/*.ts'",
    "pretest": "node scripts/ensure-native-modules.mjs",
    "test": "vitest run --fileParallelism=false",
    "test:watch": "vitest"
  },
  "keywords": [
    "kubernetes",
    "crd",
    "openai",
    "claude",
    "llm"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@aws-sdk/client-bedrock-runtime": "^3.895.0",
    "@clerum/llm-provider-attempt-contract": "file:../packages/llm-provider-attempt-contract",
    "@clerum/llm-providers": "file:../packages/llm-providers",
    "@google/genai": "^2.10.0",
    "@kubernetes/client-node": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@napi-rs/canvas": "^0.1.65",
    "@types/pdfmake": "^0.3.2",
    "ajv": "^8.17.1",
    "async-mutex": "^0.5.0",
    "better-sqlite3": "^12.10.0",
    "chart.js": "^4.4.7",
    "cron-parser": "^5.5.0",
    "docx": "^9.6.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "jose": "^6.2.1",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.70.0",
    "pdf-lib": "^1.17.1",
    "pdfmake": "^0.2.23",
    "playwright": "^1.59.1",
    "pptxgenjs": "^4.0.1",
    "prom-client": "^15.1.3",
    "safe-regex": "^2.1.1",
    "tiktoken": "^1.0.22",
    "umzug": "^3.8.3",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^20.10.0",
    "@types/safe-regex": "^1.1.6",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "eslint": "^10.2.1",
    "fast-check": "^4.9.0",
    "supertest": "^7.2.2",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
