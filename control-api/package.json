{
  "name": "clerum-control-api",
  "version": "0.1.440",
  "description": "Internal Clerum control plane REST API + UI for managing CRDs and secrets",
  "main": "dist/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs'); for (const file of ['dist/main.js','dist/migrate.js','dist/traceMaintenance.js']) { if (!fs.existsSync(file)) { throw new Error('Missing build artifact: ' + file); } }\"",
    "migrate": "node dist/migrate.js",
    "start": "node dist/main.js",
    "start:trace-maintenance": "node dist/traceMaintenance.js",
    "dev": "ts-node src/main.ts",
    "test": "vitest run --no-file-parallelism",
    "test:run": "vitest run --no-file-parallelism"
  },
  "dependencies": {
    "@clerum/image-policy": "file:../packages/image-policy",
    "@clerum/llm-providers": "file:../packages/llm-providers",
    "@clerum/workflow-recipe-capability-policy": "file:../packages/workflow-recipe-capability-policy",
    "@clerum/workflow-runtime-core": "file:../packages/workflow-runtime-core",
    "@kubernetes/client-node": "^1.3.0",
    "bcryptjs": "^3.0.3",
    "cron-parser": "^5.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.1",
    "google-auth-library": "^10.6.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vitest": "^4.0.18"
  }
}
