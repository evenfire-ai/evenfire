# Force Node + npm version match across local dev and CI containers (node:24-alpine).
# Without engine-strict=true, the engines field in package.json is informational only:
# npm install on Node 20/npm 10 succeeds and produces a lockfile missing platform-
# specific optional bindings (e.g. @rolldown/binding-darwin-arm64), which then breaks
# vitest at runtime via opaque "Cannot find native binding" errors.
engine-strict=true

# Optional dependencies (rolldown native bindings, esbuild platform packages, etc.)
# MUST be installed — they are required for vitest/rolldown/vite to load.
# Defaults to true; explicit here so an operator never silently flips it off.
include=optional
