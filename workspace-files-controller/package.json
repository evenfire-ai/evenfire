{
  "name": "clerum-workspace-files-controller",
  "version": "0.1.0",
  "description": "Per-SharedFileSystem HTTP IO service: list/stat/download (P2) and upload/replace/mkdir/move/delete (P3)",
  "main": "dist/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "lint": "eslint 'src/**/*.ts'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "kubernetes",
    "filesystem",
    "clerum",
    "sharedfilesystem"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "express": "^5.2.1",
    "jose": "^6.2.1",
    "multer": "^2.2.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.10.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  }
}
