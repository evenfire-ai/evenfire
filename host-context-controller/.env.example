# Skill Mapper - Example Environment Variables for Dev Mode
# Copy this file to .env and modify as needed

# Enable dev mode (reads from env vars instead of Kubernetes, no reconciliation)
CLERUM_DEV_MODE=true

# Server port
CONTEXT_MAPPER_PORT=8081

# MCP Servers configuration (JSON array)
# Each server needs: name, spec.image, spec.transport
# A server belongs to a context only through that context's mcpServers list below
# Note: image, env, envSecret, resources are stored in the CRD but not used in dev mode
#       (no Kubernetes Deployments are created in dev mode)
CLERUM_MCP_SERVERS='[
  {
    "name": "filesystem",
    "namespace": "dev",
    "spec": {
      "description": "Local filesystem operations",
      "image": "mcp/filesystem:latest",
      "transport": {
        "type": "sse",
        "url": "http://localhost:3001/sse",
        "port": 3001
      },
      "enabled": true
    }
  },
  {
    "name": "github",
    "namespace": "dev",
    "spec": {
      "description": "GitHub repository operations",
      "image": "mcp/github:latest",
      "transport": {
        "type": "sse",
        "url": "http://localhost:3002/sse",
        "port": 3002
      },
      "auth": {
        "type": "bearer",
        "secretRef": "github-token"
      },
      "enabled": true
    }
  },
  {
    "name": "mongodb",
    "namespace": "dev",
    "spec": {
      "description": "MongoDB database operations",
      "image": "mongodb/mongodb-mcp-server:latest",
      "transport": {
        "type": "streamableHttp",
        "url": "http://localhost:3003/mcp",
        "port": 3003
      },
      "enabled": true
    }
  },
  {
    "name": "disabled-server",
    "namespace": "dev",
    "spec": {
      "description": "This server is disabled and wont be returned by context queries",
      "image": "example/disabled:latest",
      "transport": {
        "type": "sse",
        "url": "http://localhost:3004/sse",
        "port": 3004
      },
      "enabled": false
    }
  },
  {
    "name": "other-context-server",
    "namespace": "dev",
    "spec": {
      "description": "Server in a different context",
      "image": "example/other:latest",
      "transport": {
        "type": "sse",
        "url": "http://localhost:3005/sse",
        "port": 3005
      },
      "enabled": true
    }
  }
]'

# Context definitions (JSON array)
# Mirrors the Context CRD — each context lists which MCP servers it allows.
# When set, getServerInfosByContext filters by mcpServers (matching production).
# When NOT set, every context resolves to no servers (fail-closed).
CLERUM_CONTEXTS='[
  {
    "name": "dev-context",
    "namespace": "dev",
    "spec": {
      "contextId": "dev-context",
      "description": "Dev context — allows filesystem, github, and mongodb servers",
      "mcpServers": ["filesystem", "github", "mongodb"]
    }
  },
  {
    "name": "other-context",
    "namespace": "dev",
    "spec": {
      "contextId": "other-context",
      "description": "Another context — allows only the other-context-server",
      "mcpServers": ["other-context-server"]
    }
  }
]'

# Auth tokens for servers (JSON object: serverName -> token)
# Only needed for servers that have auth configured
CLERUM_MCP_AUTH='{"github": "ghp_your_github_token_here"}'
