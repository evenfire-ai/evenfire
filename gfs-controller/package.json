{
  "name": "clerum-gfs-controller",
  "version": "0.1.0",
  "description": "gfs-controller (gfsc) — brokered HTTP file API over the Global File System drive",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "kubernetes",
    "gfs",
    "global-file-system",
    "broker"
  ],
  "license": "MIT",
  "dependencies": {
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  }
}
