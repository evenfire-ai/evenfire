# evenfire test environment — placeholder credentials.
#
# Every value below is a deliberately INVALID, obviously-fake placeholder. Each
# keeps its provider prefix so you can tell what belongs in the slot, but none
# matches a real provider token format — that keeps secret scanners from firing
# on fresh clones. Set real values in your local environment; never commit them.

# LLM Providers
OPENAI_API_KEY=sk-REPLACE-ME-not-a-real-openai-key
CLAUDE_API_KEY=sk-ant-REPLACE-ME-not-a-real-anthropic-key
ZAI_API_KEY=zai-REPLACE-ME-not-a-real-zai-key
BAILIAN_API_KEY=sk-REPLACE-ME-not-a-real-bailian-key

# Channels (empty = skip those tests)
CLERUM_TELEGRAM_BOT_TOKEN=
CLERUM_SLACK_BOT_TOKEN=xoxb-REPLACE-ME-not-a-real-slack-token

# Data stores
MONGODB_CONNECTION_STRING=mongodb://localhost:27017/test
AIRTABLE_API_KEY=pat.REPLACE-ME-not-a-real-airtable-key

# Runtime
CLERUM_DEV_MODE=true
