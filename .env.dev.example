# example-dev channel tokens — copy this to .env.dev and fill in dev bot credentials.
# .env.dev is gitignored (covered by the .env.* rule).
#
# Used by `make gcp-dev-apply-secrets` in keyper-labs/evenfire-infra (Makefile.infra),
# not by any service in this repository. LLM API keys come from .env (shared with prod).

# Telegram — register a separate dev bot via @BotFather (do NOT reuse the prod bot;
# two pollers on the same token trigger webhook conflicts).
CLERUM_TELEGRAM_BOT_TOKEN=

# Slack — dev Slack app + bot user
CLERUM_SLACK_BOT_TOKEN=

# Email/IMAP — dev account (optional)
# The target writes IMAP_USER/PASS to the clerum-channel-reader-credentials Secret as
# email-username/email-password, the keys channel-reader reads in a cluster. Keep these
# names: CLERUM_EMAIL_USERNAME/PASSWORD apply only to a local channel-reader process.
# The target does not read IMAP_HOST; clusters set it in the channel-reader ConfigMap.
CLERUM_EMAIL_IMAP_HOST=
CLERUM_EMAIL_IMAP_USER=
CLERUM_EMAIL_IMAP_PASS=
