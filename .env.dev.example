# clerum-dev channel tokens — copy this to .env.dev and fill in dev bot credentials.
# .env.dev is gitignored (covered by the .env.* rule).
#
# Used by `make gcp-dev-apply-secrets`. LLM API keys come from .env (shared with prod).

# Telegram — register a separate dev bot via @BotFather (do NOT reuse the prod bot;
# two pollers on the same token trigger webhook conflicts).
CLERUM_TELEGRAM_BOT_TOKEN=

# Slack — dev Slack app + bot user
CLERUM_SLACK_BOT_TOKEN=

# Email/IMAP — dev account (optional)
CLERUM_EMAIL_IMAP_HOST=
CLERUM_EMAIL_IMAP_USER=
CLERUM_EMAIL_IMAP_PASS=
