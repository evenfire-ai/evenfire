# egress-proxy-template-check: awk program run by egress-proxy-entrypoint on the
# NGINX templates before the official entrypoint substitutes them.
#
# 20-envsubst-on-templates.sh replaces both $NAME and ${NAME} for every defined
# environment variable, inside the NGINX syntax, after HCC has validated the
# template. A Secret value can therefore end a directive or start a new one.
# This program finds every reference to a defined variable and checks its value
# against the NGINX context the reference sits in, following the tokenizer of
# NGINX 1.30 (ngx_conf_read_token):
#
#   inside "..."                  the bytes 0x01-0x1F, 0x7F, ", $ and \ are
#                                 rejected; every other byte is accepted,
#                                 including every byte >= 0x80, whether or not
#                                 it forms valid UTF-8 (RFC 9110 obs-text)
#   inside an unquoted argument   in query position, meaning an unescaped ? came
#                                 earlier in the same argument: only
#                                 [-A-Za-z0-9._~!'()*,=:@/?] and complete %XX
#                                 escapes; + reads as a space to a form decoder,
#                                 & starts a new parameter, # ends the value,
#                                 and \ is unescaped by NGINX
#   in any other unquoted argument
#                                 anything outside [A-Za-z0-9._~-] is rejected,
#                                 except a % in a complete %XX escape
#   anywhere else                 any defined value is rejected: at the start of
#                                 an argument, inside '...', in a comment, or
#                                 after a \ the value itself changes the syntax
#
# An undefined braced reference, ${NAME}, is rejected wherever it sits. HCC
# emits that form only for the placeholders it declared in the container env,
# and envsubst leaves an undefined one in place, where NGINX reads it as one of
# its own variables, case-insensitively: ${HTTP_X} becomes the client's X
# request header. That happens when a running pod restarts after the kubelet
# has swapped in a template whose new placeholder the pod's older env does not
# define yet. An undefined bare $name (NGINX's own $host, $scheme, ...) is left
# alone, as envsubst leaves it. Values are only compared with index(), constant
# classes and a constant gsub() pattern: never used as a regex or as an output
# format. The quoted class is decided byte by byte with index() for that same
# reason: a POSIX control-character class is locale-dependent, and musl's
# regexec reports no match at all for a whole value holding an invalid UTF-8
# sequence, which let a control byte through when it followed one. On a
# rejection it prints the file, the variable name and the context, never the
# value or the template line, and exits 1.

BEGIN {
  # The query class as a string constant: BusyBox awk keeps the backslash of an
  # escaped slash inside a regex literal and then admits a backslash as a member
  # of the class.
  QUERY_VALUE_RE = "^[-A-Za-z0-9._~!'()*,=:@/?]*$"
  # Bytes 0x01-0x1F and 0x7F, built one byte at a time: an env value never
  # holds 0x00. This list is compared with index(), never used as a regex.
  CONTROL_BYTES = ""
  for (i = 1; i <= 31; i++) CONTROL_BYTES = CONTROL_BYTES sprintf("%c", i)
  CONTROL_BYTES = CONTROL_BYTES sprintf("%c", 127)
}

function has_any(value, chars,    i) {
  for (i = 1; i <= length(chars); i++) {
    if (index(value, substr(chars, i, 1))) return 1
  }
  return 0
}

# One left-to-right pass that removes non-overlapping complete escapes, as
# gsub() does: text created by a removal is not examined again. a%%4141 leaves
# a%41 and a%2%41 leaves a%2, so a malformed % stays in the value and is
# rejected instead of disappearing through a second pass.
function without_escapes(value,    rest) {
  rest = value
  gsub(/%[0-9A-Fa-f][0-9A-Fa-f]/, "", rest)
  return rest
}

function reject(name, where,    key) {
  bad = 1
  key = FILENAME SUBSEP name SUBSEP where
  if (key in reported) return
  reported[key] = 1
  print "egress-proxy-entrypoint: " FILENAME ": the value of " name " is not allowed in " where
}

function reject_undefined(name,    key) {
  bad = 1
  key = FILENAME SUBSEP name SUBSEP "undefined"
  if (key in reported) return
  reported[key] = 1
  print "egress-proxy-entrypoint: " FILENAME ": ${" name "} is not defined in the environment"
}

function check(name, context,    value) {
  if (!(name in ENVIRON)) {
    if (ref_braced) reject_undefined(name)
    return
  }
  value = ENVIRON[name]
  if (context == "quoted") {
    if (has_any(value, CONTROL_BYTES) || has_any(value, "\"$\\")) reject(name, "a quoted string")
  } else if (context == "a query value") {
    if (without_escapes(value) !~ QUERY_VALUE_RE) reject(name, "an unquoted query value")
  } else if (context == "unquoted") {
    if (without_escapes(value) !~ /^[A-Za-z0-9._~-]*$/) reject(name, "an unquoted argument")
  } else {
    reject(name, context)
  }
}

# The envsubst reference that starts at the "$" at position i of text: sets
# ref_name ("" when the "$" does not start one), ref_len (characters used) and
# ref_braced (1 for the ${NAME} form).
function reference_at(text, i,    rest) {
  rest = substr(text, i + 1)
  ref_name = ""
  ref_len = 1
  ref_braced = 0
  if (match(rest, /^\{[A-Za-z_][A-Za-z0-9_]*\}/)) {
    ref_name = substr(rest, 2, RLENGTH - 2)
    ref_len = RLENGTH + 1
    ref_braced = 1
  } else if (match(rest, /^[A-Za-z_][A-Za-z0-9_]*/)) {
    ref_name = substr(rest, 1, RLENGTH)
    ref_len = RLENGTH + 1
  }
}

FNR == 1 {
  quote = ""
  token_start = 1
  query = 0
  comment = 0
  escaped = 0
}

{
  line = $0
  n = length(line)
  for (i = 1; i <= n + 1; i++) {
    c = (i <= n) ? substr(line, i, 1) : "\n"
    if (comment) {
      if (c == "\n") {
        comment = 0
        token_start = 1
      } else if (c == "$") {
        # envsubst also substitutes inside comments; a newline in the value
        # would end the comment and start a directive.
        reference_at(line, i)
        if (ref_name != "") check(ref_name, "a comment")
        i += ref_len - 1
      }
      continue
    }
    if (escaped) {
      escaped = 0
      if (c == "$") {
        reference_at(line, i)
        if (ref_name != "") check(ref_name, "an escaped position")
        i += ref_len - 1
      }
      continue
    }
    if (c == "\\") {
      escaped = 1
      if (quote == "") {
        # A \ that opens the argument starts a token without entering the
        # token_start branch below, so it resets query position here.
        if (token_start) query = 0
        token_start = 0
      }
      continue
    }
    if (quote != "") {
      if (c == quote) {
        quote = ""
        token_start = 1
      } else if (c == "$") {
        reference_at(line, i)
        if (ref_name != "") check(ref_name, quote == "\"" ? "quoted" : "a single-quoted string")
        i += ref_len - 1
      }
      continue
    }
    if (c == " " || c == "\t" || c == "\r" || c == "\n" || c == ";" || c == "{") {
      token_start = 1
      continue
    }
    if (token_start) {
      # A token starts here: only a leading ? opens query position for the
      # references that follow it in this argument.
      query = (c == "?")
      if (c == "}") continue
      if (c == "#") {
        comment = 1
        continue
      }
      token_start = 0
      if (c == "\"" || c == "'") {
        quote = c
        continue
      }
      if (c == "$") {
        reference_at(line, i)
        if (ref_name != "") check(ref_name, "an argument start")
        i += ref_len - 1
      }
      continue
    }
    if (c == "?") {
      # An unescaped ? earlier in this argument puts every later reference in
      # it in query position.
      query = 1
    } else if (c == "$") {
      reference_at(line, i)
      if (ref_name != "") check(ref_name, query ? "a query value" : "unquoted")
      i += ref_len - 1
    }
  }
}

END { exit bad ? 1 : 0 }
