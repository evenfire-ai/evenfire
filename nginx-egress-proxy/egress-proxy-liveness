#!/bin/sh
# Kubernetes exec liveness probe for the Clerum remote MCP egress proxy.
#
#   egress-proxy-liveness <port>
#
# Exit 0 only when both hold:
#
#   * the local /health endpoint answers on <port>;
#   * the stderr log filter is a live, non-zombie process.
#
# NGINX stays PID 1 so the kubelet's QUIT/TERM reach it, which means a dead
# filter does not stop NGINX: it keeps serving while every error line is
# dropped on the closed FIFO. This probe turns that silent loss into a
# container restart. Readiness keeps using httpGet /health, so the Service
# endpoints never depend on this script.
#
# busybox only, no loops and no sleeps: one bounded wget plus two /proc reads.
# The reconciler gives the probe timeoutSeconds 5, which covers the 2 s wget
# timeout on a container limited to 100m CPU.
set -u

port="${1:-}"
if [ -z "$port" ]; then
  echo "usage: egress-proxy-liveness <port>" >&2
  exit 2
fi

wget -q -T 2 -O /dev/null "http://127.0.0.1:${port}/health" || exit 1

# The bracket keeps the pattern from matching a pgrep command line of its own
# if this script ever grows a wrapper shell.
pid="$(pgrep -f '[e]gress-proxy-log-filter' 2>/dev/null | head -n 1)"
[ -n "$pid" ] || exit 1

# Field 3 of /proc/<pid>/stat is the process state. pgrep -f does not list a
# zombie (its cmdline is empty), so a dead filter normally fails the check
# above; this one covers a filter that exits between pgrep and this read.
state="$(sed -e 's/^[^)]*) //' -e 's/ .*$//' "/proc/${pid}/stat" 2>/dev/null)" || exit 1
[ -n "$state" ] || exit 1
[ "$state" != "Z" ] || exit 1

exit 0
