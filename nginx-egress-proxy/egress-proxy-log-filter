# Redact the query string of the `upstream: "..."` field in NGINX error lines.
#
# NGINX writes the upstream URL of a failed request as:
#
#   ... upstream: "https://<peer>/<path>?<query>", host: "..."
#
# The remote baseUrl query can carry a credential (#1240), and envsubst resolves
# it inside this container, so the line must never leave the container with it.
# Everything before the first "?" of that field (scheme, peer IP:port or the
# upstream block name, path) and the rest of the line stay untouched: the peer
# classifies a 502 race in the field evidence, and the message text is what the
# error alerts match.
#
# The field ends at the closing quote NGINX writes before the next context
# field it appends, `, host: "` or `, referrer: "`, not at the first quote: a
# quote inside the substituted value must not end the redaction early. A line
# with neither field (no Host header, or cut at NGX_MAX_ERROR_STR, 2047 bytes)
# is redacted to the end of the line, keeping a final closing quote.
#
# Every `upstream: "` on the line is processed, not only the first. The message
# text before the real field can quote bytes the upstream sent (for example
# `upstream sent duplicate header line: "<name>: <value>"`), so an upstream can
# put a fake field, or a fake `", host: "`, ahead of the real one.
#
# One line per record plus an explicit flush: a block-buffered filter would
# delay every error line and, once the 64 KiB FIFO filled, block NGINX's
# workers.
BEGIN {
    FIELD = "upstream: \""
    NEXT_HOST = "\", host: \""
    NEXT_REFERRER = "\", referrer: \""
}

# Length of the field value at the start of s, which begins right after the
# field's opening quote.
function field_length(s,    n, i) {
    n = length(s)
    if (n > 0 && substr(s, n) == "\"") n = n - 1
    i = index(s, NEXT_HOST)
    if (i > 0 && i - 1 < n) n = i - 1
    i = index(s, NEXT_REFERRER)
    if (i > 0 && i - 1 < n) n = i - 1
    return n
}

{
    out = ""
    rest = $0
    while ((start = index(rest, FIELD)) > 0) {
        out = out substr(rest, 1, start + length(FIELD) - 1)
        rest = substr(rest, start + length(FIELD))
        len = field_length(rest)
        mark = index(substr(rest, 1, len), "?")
        if (mark > 0) {
            out = out substr(rest, 1, mark) "REDACTED"
            rest = substr(rest, len + 1)
        }
    }
    print out rest
    fflush()
}
