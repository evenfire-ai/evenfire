{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".ts-out"
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "playwright-report", "test-results", ".ts-out"]
}
