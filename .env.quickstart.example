# ── LLM API key ─────────────────────────────────────────────────────────────
# Set exactly ONE provider and its key.  The service auto-detects from the
# first non-empty key when CLERUM_MODEL_PROVIDER is omitted.

CLERUM_MODEL_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Alternative providers (uncomment ONE, set the matching key):
# CLERUM_MODEL_PROVIDER=claude
# CLAUDE_API_KEY=sk-ant-...

# CLERUM_MODEL_PROVIDER=zai
# ZAI_API_KEY=zai-...

# CLERUM_MODEL_PROVIDER=bailian
# BAILIAN_API_KEY=sk-...

# ── Telegram surface (optional) ──────────────────────────────────────────────
# Only needed when running with `docker compose --profile telegram up`.
# CLERUM_TELEGRAM_BOT_TOKEN=<your-bot-token>
# TELEGRAM_ALLOWED_USER_ID=<your-numeric-telegram-user-id>
