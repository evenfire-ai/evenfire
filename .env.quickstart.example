# ── LLM API key ─────────────────────────────────────────────────────────────
# Set exactly ONE provider and its key.  The service auto-detects from the
# first non-empty key when CLERUM_MODEL_PROVIDER is omitted.

CLERUM_MODEL_PROVIDER=openai
OPENAI_API_KEY=sk-...

# Alternative providers (uncomment ONE, set the matching key):
# CLERUM_MODEL_PROVIDER=claude
# CLAUDE_API_KEY=sk-ant-...

# CLERUM_MODEL_PROVIDER=zai
# ZAI_API_KEY=zai-...

# CLERUM_MODEL_PROVIDER=bailian
# BAILIAN_API_KEY=sk-...

# ── MCP servers (optional) ───────────────────────────────────────────────────
# Wire dev MCP servers as a JSON array. Each entry needs name, contextRef,
# transport, enabled, AND a status object with {"deployed":true,"ready":true} —
# a server without status.ready is parsed but skipped as "not ready".
# The value is passed through to the mcp-host container by docker-compose.yml.
# Example (an HTTP MCP server reachable at http://my-mcp:3000/mcp):
# CLERUM_MCP_SERVERS=[{"name":"my-mcp","contextRef":"dev-context","transport":{"type":"streamableHttp","url":"http://my-mcp:3000/mcp"},"enabled":true,"status":{"deployed":true,"ready":true}}]

# ── Telegram surface (optional) ──────────────────────────────────────────────
# Only needed when running with `docker compose --profile telegram up`.
# CLERUM_TELEGRAM_BOT_TOKEN=<your-bot-token>
# TELEGRAM_ALLOWED_USER_ID=<your-numeric-telegram-user-id>
