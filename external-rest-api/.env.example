# Local development only: start control-api with CLERUM_DEV_MODE=true first.
# Export these values before starting; npm run dev does not load this file.
# NODE_ENV=production rejects CLERUM_DEV_MODE=true and requires an explicit public key.
CLERUM_DEV_MODE=true
# Unset or blank uses control-api/.dev-keys in this checkout. A nonblank override
# must be absolute and identical in control-api, rpc-proxy, and external-rest-api.
EVENFIRE_DEV_KEY_STORE=
EXTERNAL_REST_API_PORT=8091
EXTERNAL_REST_API_CORS_ORIGIN=*
EXTERNAL_REST_API_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
EXTERNAL_REST_API_CONTROL_API_BASE_URL=http://profile-control-funnel.profiles.svc.cluster.local:8080/api/v1
EXTERNAL_REST_API_CONTROL_API_SERVICE_TOKEN=replace-with-external-rest-api-token
EXTERNAL_REST_API_CONTROL_API_SERVICE_NAME=external-rest-api
EXTERNAL_REST_API_MEMBER_REGISTRATION_SERVICE_BASE_URL=http://member-registration-service.profiles.svc.cluster.local:8092/api/v1
EXTERNAL_REST_API_MEMBER_REGISTRATION_SERVICE_SERVICE_TOKEN=replace-with-external-rest-api-member-registration-service-token
EXTERNAL_REST_API_MEMBER_REGISTRATION_SERVICE_SERVICE_NAME=external-rest-api
# Blank uses session.public.pem from the store in explicit dev mode. If control-api
# uses CONTROL_API_SESSION_JWT_PRIVATE_KEY, set its matching public key here instead.
# Restart/reconfigure after changing keys; running verifiers do not refresh them.
# Explicit verifier keys require one RSA >=2048 PEM object (SPKI/PKCS#1 public
# or X509 carrier); private PEM env input is legacy-compatible, not recommended.
# Public store files never accept private material. Material/read limit: 64 KiB.
# The store requires POSIX guarantees, trusted ancestors and the same effective
# UID across services; otherwise supply the matching keys explicitly.
EXTERNAL_REST_API_JWT_PUBLIC_KEY=
EXTERNAL_REST_API_JWT_ISSUER=control-api
EXTERNAL_REST_API_JWT_AUDIENCE=profile-ui
EXTERNAL_REST_API_ENABLE_DEV_LOGIN=false
