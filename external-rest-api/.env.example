EXTERNAL_REST_API_PORT=8091
EXTERNAL_REST_API_CORS_ORIGIN=*
EXTERNAL_REST_API_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
EXTERNAL_REST_API_CONTROL_API_BASE_URL=http://profile-control-funnel.profiles.svc.cluster.local:8080/api/v1
EXTERNAL_REST_API_CONTROL_API_SERVICE_TOKEN=replace-with-external-rest-api-token
EXTERNAL_REST_API_CONTROL_API_SERVICE_NAME=external-rest-api
EXTERNAL_REST_API_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nreplace-with-session-rs256-public-key\n-----END PUBLIC KEY-----
EXTERNAL_REST_API_JWT_ISSUER=control-api
EXTERNAL_REST_API_JWT_AUDIENCE=profile-ui
EXTERNAL_REST_API_JSON_BODY_LIMIT=150mb
EXTERNAL_REST_API_PROFILE_SESSION_COOKIE_TTL_SECONDS=43200

# Advertised to the desktop app via GET /api/v1/desktop/environment.
# The defaults below are dev-only — point them at your deployment.
EXTERNAL_REST_API_PUBLIC_BASE_URL=http://127.0.0.1:8091
EXTERNAL_REST_API_DESKTOP_RPC_PROXY_BASE_URL=http://127.0.0.1:8094
EXTERNAL_REST_API_DESKTOP_APP_NAME=Evenfire
EXTERNAL_REST_API_DESKTOP_RELEASE_BASE_URL=https://github.com/evenfire-ai/evenfire/releases
