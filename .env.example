# =============================================================================
# Evenfire — Environment Variables (first-run setup)
# =============================================================================
#
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
#
# At minimum, set ADMIN_PASSWORD and ONE LLM key below, then run
# `make minikube-setup`. Setup creates the K8s secrets for you; the remaining
# MCP/channel credentials are optional and only needed for those integrations.
#
# See docs/get-started/quickstart.md for the full walkthrough.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM API Keys
# K8s Secret: mcp-host-keys (namespace: mcp-host)
# Used by: mcp-host via Host CRD secretRef
# -----------------------------------------------------------------------------

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Claude — https://console.anthropic.com/
CLAUDE_API_KEY=

# ZAI (z.ai) — https://z.ai
ZAI_API_KEY=

# Alibaba Cloud Model Studio (Bailian) — https://modelstudio.console.alibabacloud.com/
# Coding Plan API key: https://modelstudio.console.alibabacloud.com/ap-southeast-1/?tab=globalset#/efm/coding_plan
BAILIAN_API_KEY=

# Setup auto-selects the agent's provider from the first of the four keys above.
# Other supported providers need CLERUM_MODEL_PROVIDER + CLERUM_MODEL_NAME below,
# and their key reaches the cluster only when you run `make minikube-apply-secrets`
# after `make minikube-setup` (setup itself writes only the four keys above):
#   OPENROUTER_API_KEY GEMINI_API_KEY DEEPSEEK_API_KEY GROQ_API_KEY
#   TOGETHER_API_KEY FIREWORKS_API_KEY MISTRAL_API_KEY XAI_API_KEY
#   CEREBRAS_API_KEY DEEPINFRA_API_KEY PERPLEXITY_API_KEY MOONSHOT_API_KEY
#   NEBIUS_API_KEY NOVITA_API_KEY MINIMAX_API_KEY AZURE_OPENAI_API_KEY
#   VERTEX_SERVICE_ACCOUNT_JSON AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY
# See docs/llm-providers/README.md for per-provider settings.

# -----------------------------------------------------------------------------
# Platform admin password  (REQUIRED for `make minikube-setup`)
# -----------------------------------------------------------------------------
# One value, two logins:
#   - Control UI  → username `admin`
#   - Desktop App → the seeded user
# No default ships. Setup aborts in Step 1 if this is unset.
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# MCP Server Credentials
# -----------------------------------------------------------------------------

# MongoDB Atlas connection string
# K8s Secret: mcp-mongodb-credentials (namespace: mcp-server), key: connection-string
# Used by: MongoDB MCP server pod via envSecret
# How to get: https://www.mongodb.com/cloud/atlas/register (free M0 cluster)
# Format: mongodb+srv://user:password@cluster.mongodb.net/clerum-test
MONGODB_CONNECTION_STRING=

# Airtable Personal Access Token
# K8s Secret: mcp-airtable-credentials (namespace: mcp-server), key: api-key
# Used by: Airtable MCP server pod via envSecret
# How to get: https://airtable.com/create/tokens
# Scopes: data.records:read, data.records:write, schema.bases:read
AIRTABLE_API_KEY=

# Airtable Base ID (for seed scripts only — not injected into K8s)
# Found in the Airtable URL: https://airtable.com/appXXXXXXXX/...
AIRTABLE_BASE_ID=

# -----------------------------------------------------------------------------
# Channel credentials (channel-reader dev mode only)
# `make minikube-setup` does NOT read these. On a cluster, set channel
# credentials per CommunicationChannel in the Control UI (Channel credentials
# panel); see docs/how-to/connect-telegram.md and docs/how-to/connect-slack.md.
# These variables are read only by channel-reader with CLERUM_DEV_MODE=true,
# e.g. the docker compose `telegram` profile.
# -----------------------------------------------------------------------------

# Telegram Bot Token — https://t.me/BotFather → /newbot
CLERUM_TELEGRAM_BOT_TOKEN=

# Slack Bot Token — https://api.slack.com/apps → OAuth Bot Token (xoxb-...)
# Required scopes: chat:write, channels:history, channels:read, users:read
CLERUM_SLACK_BOT_TOKEN=

# Email (optional — only for testing against a real IMAP/SMTP server, e.g. Gmail)
CLERUM_EMAIL_USERNAME=
CLERUM_EMAIL_PASSWORD=
CLERUM_EMAIL_IMAP_HOST=imap.gmail.com
CLERUM_EMAIL_IMAP_PORT=993
CLERUM_EMAIL_SMTP_HOST=smtp.gmail.com
CLERUM_EMAIL_SMTP_PORT=587

# -----------------------------------------------------------------------------
# Model Configuration (optional overrides)
# These go into mcp-host ConfigMap, not secrets
# -----------------------------------------------------------------------------

# LLM provider id (any id from docs/llm-providers/README.md). When unset, setup
# uses the first key present: openai, claude, zai, bailian (no key: openai).
# CLERUM_MODEL_PROVIDER=openai

# Model name. Only valid together with CLERUM_MODEL_PROVIDER, and the pair must
# be enabled in the model allowlist. Defaults: openai gpt-5.4-mini,
# claude claude-sonnet-4-6, zai glm-5.1, bailian qwen3-coder-plus.
# CLERUM_MODEL_NAME=gpt-5.4-mini
