{
  "name": "workload-recipes-controller",
  "version": "0.1.324",
  "description": "Workload Recipes Controller (WRC) - WorkloadRecipe lifecycle management and MCP server interface",
  "main": "dist/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "build:docker": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "cd tests/e2e && npx vitest run --config vitest.config.ts",
    "lint": "eslint src --ext .ts",
    "backfill:secret-ownership": "node dist/cli/backfillRecipeSecretOwnership.js"
  },
  "keywords": [
    "kubernetes",
    "crd",
    "mcp",
    "workflow-recipes",
    "wrc",
    "workload-recipe"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1009.0",
    "@clerum/codex-catalog-projection": "file:../packages/codex-catalog-projection",
    "@clerum/image-policy": "file:../packages/image-policy",
    "@clerum/llm-providers": "file:../packages/llm-providers",
    "@clerum/network-policy-core": "file:../packages/network-policy-core",
    "@clerum/workflow-recipe-capability-policy": "file:../packages/workflow-recipe-capability-policy",
    "@clerum/workflow-runtime-core": "file:../packages/workflow-runtime-core",
    "@kubernetes/client-node": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "cron-parser": "^5.5.0",
    "jose": "^6.2.1",
    "mongodb": "^6.21.0",
    "pg": "^8.20.0",
    "prom-client": "^15.1.3",
    "typescript": "^5.3.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.20.0",
    "js-yaml": "^4.1.1",
    "ts-node": "^10.9.2",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  }
}
