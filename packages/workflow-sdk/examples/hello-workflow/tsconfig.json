{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "baseUrl": ".",
    "paths": {
      "@clerum/workflow-sdk": ["../../src/index"]
    },
    "types": ["node"]
  },
  "include": ["./*.ts", "../../src/**/*.ts"]
}
