{
  "name": "@clerum/jwt-key-policy",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical RSA JWT identity policy and local development key storage",
  "main": "index.cjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.cjs",
      "default": "./index.cjs"
    },
    "./dev-store": {
      "types": "./dev-store.d.ts",
      "require": "./dev-store.cjs",
      "default": "./dev-store.cjs"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node --check index.cjs && node --check dev-store.cjs",
    "test": "node --test test/*.test.cjs",
    "test:crypto": "node --test test/policy-*.test.cjs test/crypto-*.test.cjs"
  },
  "license": "MIT"
}
